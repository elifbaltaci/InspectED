@model IEnumerable<InspectED.ViewModels.LocationViewModel>

@{
    ViewData["Title"] = "All Locations";
}

<div class="container p-4">
    <div class="row">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h3 class="p-4">All Locations</h3>

            <a class="btn btn-dark" asp-controller="Location" asp-action="Add">
                Add Location
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 p-4">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Location</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var location in Model)
                    {
                        <tr>
                            <td>@location.LocationId</td>
                            <td>@location.Name</td>

                            <td>
                                <a class="btn btn-dark"
                                       asp-action="Edit"
                                       asp-controller="Location"
                                       asp-route-id="@location.LocationId">
                                    Edit
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-danger"
                                       asp-action="Delete"
                                       asp-controller="Location"
                                       asp-route-id="@location.LocationId"
                                       onclick="return confirm('Delete this location?')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>