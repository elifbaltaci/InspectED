@model InspectED.ViewModels.LocationViewModel
@{
    ViewData["Title"] = "Add New Location";
}

<div class="p-4 container">
    <div class="row p-4">
        <div class="col-md-12">
            <h3>Add New Location</h3>
        </div>
    </div>
    <div class="row p-4">
        <div class="col-md-6">
            <form asp-controller="Location" asp-action="Add" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Location Name</label>
                    <input asp-for="Name" type="text" class="form-control" name="name"/>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-dark">Submit</button>
            </form>
        </div>
    </div>
</div>