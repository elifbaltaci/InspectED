@model InspectED.ViewModels.DeviceViewModel
@{
    ViewData["Title"] = "All Devices";
}

<div class="container p-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h3>Add New Device</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form asp-controller="Devices" asp-action="Add" method="post">

                <div class="mb-3">
                    <label asp-for="AssetTag" class="form-label fw-bold">Asset Tag</label>
                    <input asp-for="AssetTag" class="form-control" />
                    <span asp-validation-for="AssetTag" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SerialNumber" class="form-label fw-bold">Serial Number</label>
                    <input asp-for="SerialNumber" class="form-control" />
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Model" class="form-label fw-bold">Model</label>
                    <input asp-for="Model" class="form-control" />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AssignedUserEmail" class="form-label fw-bold">Assigned User Email</label>
                    <input asp-for="AssignedUserEmail" type="email" class="form-control" />
                    <span asp-validation-for="AssignedUserEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LocationId" class="form-label fw-bold">Location</label>
                    <select asp-for="LocationId" asp-items="ViewBag.Locations" class="form-select">
                        <option value="">-- Select Location --</option>
                    </select>
                    <span asp-validation-for="LocationId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ScreenCondition" class="form-label fw-bold">Screen Condition</label>
                    <select asp-for="ScreenCondition" class="form-select">
                        <option value="">-- Select Screen Condition --</option>
                        <option value="Good">Good</option>
                        <option value="Scratched">Scratched</option>
                        <option value="Cracked">Cracked</option>
                        <option value="Broken">Broken</option>
                    </select>
                    <span asp-validation-for="ScreenCondition" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="KeyboardCondition" class="form-label fw-bold">Keyboard Condition</label>
                    <select asp-for="KeyboardCondition" class="form-select">
                        <option value="">-- Select Keyboard Condition --</option>
                        <option value="Good">Good</option>
                        <option value="Missing Keys">Missing Keys</option>
                        <option value="Not Working">Not Working</option>
                    </select>
                    <span asp-validation-for="KeyboardCondition" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BatteryCondition" class="form-label fw-bold">Battery Condition</label>
                    <select asp-for="BatteryCondition" class="form-select">
                        <option value="">-- Select Battery Condition --</option>
                        <option value="Good">Good</option>
                        <option value="Fair">Fair</option>
                        <option value="Poor">Poor</option>
                    </select>
                    <span asp-validation-for="BatteryCondition" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="ChargerAvailable" class="form-check-input" type="checkbox" />
                    <label asp-for="ChargerAvailable" class="form-check-label fw-bold">Charger Available</label>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="WifiWorking" class="form-check-input" type="checkbox" />
                    <label asp-for="WifiWorking" class="form-check-label fw-bold">WiFi Work</label>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="TestingReady" class="form-check-input" type="checkbox" />
                    <label asp-for="TestingReady" class="form-check-label fw-bold">Testing Ready</label>
                </div>

                <div class="mb-3">
                    <label asp-for="InspectionDate" class="form-label fw-bold">Inspection Date</label>
                    <input asp-for="InspectionDate" type="date" class="form-control" />
                    <span asp-validation-for="InspectionDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label fw-bold">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-dark">Submit</button>
            </form>
        </div>
    </div>
</div>