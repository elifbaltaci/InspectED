@{
    ViewData["Title"] = "Home Page";
}

<div class="container p-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title">Devices</h5>
                    <p class="card-text">Get device details</p>
                    <a asp-controller="Device" asp-action="Index" class="btn btn-dark">Click here!</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title">Location</h5>
                    <p class="card-text">Get location details</p>
                    <a asp-controller="Location" asp-action="Index" class="btn btn-dark">Click here!</a>
                </div>
            </div>
        </div>

    </div>
</div>